---
import Icon from "./Icon.astro";
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  breadcrumbs?: { name: string; href: string }[];
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  compact?: boolean;
}
const { eyebrow, title, subtitle, breadcrumbs, primary, secondary, compact = false } = Astro.props;
---
<section class:list={["relative overflow-hidden border-b border-line", compact ? "pt-32 pb-14 sm:pt-36 sm:pb-16" : "pt-36 pb-20 sm:pt-44 sm:pb-24"]}>
  <div class="grid-bg pointer-events-none absolute inset-0"></div>
  <div class="pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-electric/20 blur-[120px]"></div>
  <div class="pointer-events-none absolute -right-32 top-20 h-72 w-72 rounded-full bg-cyan/10 blur-[90px]"></div>

  <div class="container-x relative">
    {breadcrumbs && (
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-muted">
          <li><a href="/" class="inline-block py-1.5 hover:text-white">Home</a></li>
          {breadcrumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true" class="text-line">/</span>
              {i === breadcrumbs.length - 1 ? <span aria-current="page" class="text-ink">{c.name}</span> : <a href={c.href} class="inline-block py-1.5 hover:text-white">{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <div class="max-w-4xl">
      {eyebrow && <p class="eyebrow"><Icon name="bolt" class="size-3.5" />{eyebrow}</p>}
      <h1 class="chrome-text mt-5 text-4xl font-extrabold leading-[1.04] sm:text-5xl lg:text-6xl">{title}</h1>
      {subtitle && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{subtitle}</p>}
      {(primary || secondary) && (
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          {primary && <a href={primary.href} class="btn btn-primary">{primary.label} <Icon name="arrow" class="size-4" /></a>}
          {secondary && <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>}
        </div>
      )}
      <slot />
    </div>
  </div>
</section>
