---
import Icon from "./Icon.astro";
import { business } from "../config/business";
import { publishedServices } from "../data/services";

const path = Astro.url.pathname;
const nav = [
  { label: "Projects", href: "/projects" },
  { label: "Reviews", href: "/reviews" },
  { label: "About", href: "/about" },
  { label: "Service Areas", href: "/service-areas" },
  { label: "FAQ", href: "/faq" },
];
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" data-scrolled="false">
  <div class="header-bg absolute inset-0 -z-10 border-b border-transparent transition-all duration-300"></div>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-electric focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
  <div class="container-x flex h-18 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${business.name} home`}>
      <img src="/media/logo.webp" alt={business.legalName} width="640" height="154" class="h-10 w-auto sm:h-11" style="mix-blend-mode: screen" fetchpriority="high" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <div class="relative" data-dropdown>
        <button type="button" class="flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-semibold text-ink/90 hover:text-white" aria-expanded="false" aria-controls="services-menu" data-dropdown-trigger>
          Services <Icon name="chevron" class="size-4 transition-transform" />
        </button>
        <div id="services-menu" class="invisible absolute left-0 top-full w-80 pt-3 opacity-0 transition-all duration-200" data-dropdown-panel>
          <ul class="card overflow-hidden p-2 shadow-2xl shadow-black/60">
            {publishedServices.map((s) => (
              <li>
                <a href={`/${s.slug}`} class="group flex items-start gap-3 rounded-xl p-3 hover:bg-white/[0.05]">
                  <span class="mt-0.5 grid size-9 shrink-0 place-items-center rounded-lg bg-electric/15 text-glow"><Icon name={s.icon} class="size-5" /></span>
                  <span>
                    <span class="block text-sm font-semibold text-ink group-hover:text-white">{s.navLabel}</span>
                    <span class="block text-xs leading-snug text-muted">{s.cardBlurb}</span>
                  </span>
                </a>
              </li>
            ))}
            <li class="mt-1 border-t border-line pt-1">
              <a href="/services" class="flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-semibold text-glow hover:bg-white/[0.05]">All services <Icon name="arrow" class="size-4" /></a>
            </li>
          </ul>
        </div>
      </div>
      {nav.map((n) => (
        <a href={n.href} class:list={["rounded-lg px-3 py-2 text-sm font-semibold transition", isActive(n.href) ? "text-white" : "text-ink/80 hover:text-white"]} aria-current={isActive(n.href) ? "page" : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      {business.phone && (
        <a href={`tel:${business.phone.e164}`} class="btn btn-ghost hidden !min-h-11 !px-4 md:inline-flex" data-track="click_to_call">
          <Icon name="phone" class="size-4" /> <span class="tabular">{business.phone.display}</span>
        </a>
      )}
      <a href="/request-estimate" class="btn btn-primary hidden !min-h-11 !px-4 sm:inline-flex">Get Estimate</a>
      <button type="button" class="grid size-11 place-items-center rounded-xl border border-line text-ink lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-[60] hidden lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="absolute inset-0 bg-void/80 backdrop-blur-md" data-menu-close></div>
  <div class="absolute inset-y-0 right-0 flex w-full max-w-sm flex-col overflow-y-auto border-l border-line bg-deep p-6">
    <div class="flex items-center justify-between">
      <img src="/media/logo.webp" alt="" width="640" height="154" class="h-9 w-auto" style="mix-blend-mode: screen" />
      <button type="button" class="grid size-11 place-items-center rounded-xl border border-line" aria-label="Close menu" data-menu-close>
        <Icon name="close" class="size-6" />
      </button>
    </div>
    <p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-muted">Services</p>
    <ul class="mt-3 space-y-1">
      {publishedServices.map((s) => (
        <li><a href={`/${s.slug}`} class="flex items-center gap-3 rounded-xl px-3 py-3 font-semibold hover:bg-white/5"><Icon name={s.icon} class="size-5 text-glow" />{s.navLabel}</a></li>
      ))}
    </ul>
    <ul class="mt-4 space-y-1 border-t border-line pt-4">
      {[{ label: "EV Readiness Check", href: "/ev-readiness-check" }, { label: "How It Works", href: "/how-it-works" }, ...nav, { label: "Contact", href: "/contact" }].map((n) => (
        <li><a href={n.href} class="block rounded-xl px-3 py-3 font-semibold hover:bg-white/5">{n.label}</a></li>
      ))}
    </ul>
    <div class="mt-auto space-y-3 pt-8">
      {business.phone && (
        <a href={`tel:${business.phone.e164}`} class="btn btn-ghost w-full" data-track="click_to_call"><Icon name="phone" class="size-4" /> Call {business.phone.display}</a>
      )}
      <a href="/request-estimate" class="btn btn-primary w-full">Get My Estimate</a>
    </div>
  </div>
</div>

<style>
  #site-header[data-scrolled="true"] .header-bg {
    background: rgb(4 8 15 / 0.82);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--color-line);
  }
  [data-dropdown]:hover [data-dropdown-panel],
  [data-dropdown][data-open="true"] [data-dropdown-panel] {
    visibility: visible;
    opacity: 1;
  }
  [data-dropdown][data-open="true"] [data-dropdown-trigger] svg { transform: rotate(180deg); }
  .h-18 { height: 4.5rem; }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const onScroll = () => header.setAttribute("data-scrolled", String(window.scrollY > 12));
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Services dropdown: click/keyboard toggle (hover handled by CSS)
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dd) => {
    const trigger = dd.querySelector<HTMLButtonElement>("[data-dropdown-trigger]")!;
    const set = (open: boolean) => {
      dd.dataset.open = String(open);
      trigger.setAttribute("aria-expanded", String(open));
    };
    trigger.addEventListener("click", () => set(dd.dataset.open !== "true"));
    dd.addEventListener("focusout", (e) => {
      if (!dd.contains(e.relatedTarget as Node)) set(false);
    });
    dd.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { set(false); trigger.focus(); }
    });
  });

  // Mobile menu
  const menu = document.getElementById("mobile-menu")!;
  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]")!;
  const setMenu = (open: boolean) => {
    menu.classList.toggle("hidden", !open);
    openBtn.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) menu.querySelector<HTMLElement>("[data-menu-close]:not(div)")?.focus();
    else openBtn.focus();
  };
  openBtn.addEventListener("click", () => setMenu(true));
  menu.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", () => setMenu(false)));
  menu.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
