---
// Animated diagram: panel → dedicated circuit → Level 2 charger → vehicle.
// Pure SVG + CSS; static under prefers-reduced-motion.
---
<figure class="relative" aria-label="Diagram: power flows from the electrical panel through a dedicated circuit to a Level 2 charger and into the vehicle.">
  <svg viewBox="0 0 560 360" class="h-auto w-full" role="img" aria-hidden="true">
    <defs>
      <linearGradient id="pf-flow" x1="0" x2="1">
        <stop offset="0" stop-color="#7fe3ff" stop-opacity="0" />
        <stop offset=".5" stop-color="#7fe3ff" />
        <stop offset="1" stop-color="#1677ff" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="pf-metal" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1b2d45" />
        <stop offset="1" stop-color="#0c1829" />
      </linearGradient>
      <filter id="pf-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="4" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
    </defs>

    <!-- floor line -->
    <line x1="20" y1="320" x2="540" y2="320" stroke="rgb(148 190 255 / .15)" stroke-width="1.5" />

    <!-- Panel -->
    <g>
      <rect x="40" y="70" width="110" height="170" rx="10" fill="url(#pf-metal)" stroke="rgb(127 227 255 / .35)" />
      <rect x="54" y="86" width="82" height="18" rx="4" fill="#0a1422" stroke="rgb(127 227 255 / .2)" />
      {Array.from({ length: 6 }).map((_, i) => (
        <g>
          <rect x="56" y={116 + i * 18} width="34" height="11" rx="2.5" fill="#15253b" stroke="rgb(148 190 255 / .25)" />
          <rect x="100" y={116 + i * 18} width="34" height="11" rx="2.5" fill={i === 3 ? "#1677ff" : "#15253b"} stroke={i === 3 ? "#7fe3ff" : "rgb(148 190 255 / .25)"} class={i === 3 ? "pf-breaker" : ""} />
        </g>
      ))}
      <text x="95" y="262" text-anchor="middle" fill="#a3b2c6" font-size="12" font-family="Inter Variable, sans-serif" font-weight="600">PANEL</text>
    </g>

    <!-- Circuit path -->
    <path id="pf-path" d="M134 172 H200 Q215 172 215 157 V110 Q215 95 230 95 H320 Q335 95 335 110 V150" fill="none" stroke="rgb(127 227 255 / .18)" stroke-width="3" stroke-linecap="round" />
    <path d="M134 172 H200 Q215 172 215 157 V110 Q215 95 230 95 H320 Q335 95 335 110 V150" fill="none" stroke="url(#pf-flow)" stroke-width="3" stroke-linecap="round" stroke-dasharray="60 340" class="pf-current" filter="url(#pf-glow)" />
    <text x="275" y="84" text-anchor="middle" fill="#7fe3ff" font-size="11" font-family="Inter Variable, sans-serif" font-weight="700" letter-spacing="1.5">DEDICATED CIRCUIT</text>

    <!-- Charger -->
    <g>
      <rect x="305" y="150" width="60" height="96" rx="12" fill="url(#pf-metal)" stroke="rgb(127 227 255 / .45)" />
      <rect x="318" y="166" width="34" height="22" rx="4" fill="#0a1422" />
      <circle cx="335" cy="177" r="5" fill="#11b5e4" class="pf-led" />
      <path d="M332 205 l-5 9 h7 l-3 9 9-12 h-7 l3-6z" fill="#7fe3ff" />
      <text x="335" y="266" text-anchor="middle" fill="#a3b2c6" font-size="12" font-family="Inter Variable, sans-serif" font-weight="600">LEVEL 2</text>
    </g>

    <!-- Cable to car -->
    <path d="M365 225 C400 240 405 290 440 282" fill="none" stroke="rgb(127 227 255 / .25)" stroke-width="3" stroke-linecap="round" />
    <path d="M365 225 C400 240 405 290 440 282" fill="none" stroke="url(#pf-flow)" stroke-width="3" stroke-linecap="round" stroke-dasharray="40 200" class="pf-current-2" filter="url(#pf-glow)" />

    <!-- Car (side profile) -->
    <g transform="translate(420 220)">
      <path d="M8 62 C4 62 2 58 3 54 L8 40 C10 34 16 30 24 29 L44 27 L62 12 C66 9 71 8 76 8 H104 C110 8 115 11 118 15 L128 28 C136 30 140 36 140 44 V56 C140 60 137 62 133 62" fill="url(#pf-metal)" stroke="rgb(127 227 255 / .5)" stroke-width="1.5" />
      <path d="M50 28 L66 15 H100 L110 28 Z" fill="#0a1422" stroke="rgb(127 227 255 / .25)" />
      <circle cx="34" cy="64" r="13" fill="#07111f" stroke="rgb(148 190 255 / .45)" stroke-width="2" />
      <circle cx="112" cy="64" r="13" fill="#07111f" stroke="rgb(148 190 255 / .45)" stroke-width="2" />
      <rect x="22" y="40" width="18" height="6" rx="3" fill="#11b5e4" class="pf-led" />
    </g>
  </svg>
  <figcaption class="sr-only">Power travels from the electrical panel, through a dedicated circuit, to a Level 2 charger, and into the vehicle.</figcaption>
</figure>

<style>
  .pf-current { stroke-dashoffset: 0; animation: pf-flow 2.6s linear infinite; }
  .pf-current-2 { animation: pf-flow2 1.8s linear infinite; }
  .pf-led { animation: pf-blink 2.4s ease-in-out infinite; }
  .pf-breaker { animation: pf-blink 2.6s ease-in-out infinite; }
  @keyframes pf-flow { to { stroke-dashoffset: -400; } }
  @keyframes pf-flow2 { to { stroke-dashoffset: -240; } }
  @keyframes pf-blink { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
</style>
