---
import Icon from "./Icon.astro";
import { business } from "../config/business";
---
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-void/90 px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-lg md:hidden">
  <div class="flex gap-2">
    {business.phone && (
      <a href={`tel:${business.phone.e164}`} class="btn btn-ghost flex-1 !px-2" data-track="click_to_call"><Icon name="phone" class="size-4" /> Call</a>
    )}
    {business.phone && business.smsEnabled && (
      <a href={`sms:${business.phone.e164}`} class="btn btn-ghost flex-1 !px-2" data-track="click_to_text"><Icon name="message" class="size-4" /> Text</a>
    )}
    {!business.phone && (
      <a href="/ev-readiness-check" class="btn btn-ghost flex-1 !px-2"><Icon name="gauge" class="size-4" /> EV Check</a>
    )}
    <a href="/request-estimate" class="btn btn-primary flex-[1.4] !px-2"><Icon name="bolt" class="size-4" /> Get Estimate</a>
  </div>
</div>
