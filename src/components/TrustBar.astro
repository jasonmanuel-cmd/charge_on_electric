---
import Icon from "./Icon.astro";
import { business, licenseVisible } from "../config/business";

// Verified facts are preferred; capability statements fill in until they exist.
type Item = { icon: "shield" | "plug" | "panel" | "building" | "pin" | "star" | "clipboard"; text: string };
const items: Item[] = [];
if (licenseVisible()) items.push({ icon: "shield", text: `CSLB License #${business.license.number}` });
if (business.insured) items.push({ icon: "shield", text: "Licensed & Insured" });
if (business.reviews.rating && business.reviews.count)
  items.push({ icon: "star", text: `${business.reviews.rating.toFixed(1)}★ from ${business.reviews.count} ${business.reviews.platform ?? ""} reviews` });

const capability: Item[] = [
  { icon: "plug", text: "EV Charger Installation" },
  { icon: "panel", text: "Electrical Panel Upgrades" },
  { icon: "building", text: "Residential & Commercial" },
  { icon: "clipboard", text: "Clear, Written Estimates" },
  { icon: "pin", text: business.serviceAreaStatement },
];
const shown = [...items, ...capability].slice(0, 5);
---
<section aria-label="At a glance" class="relative border-y border-line bg-deep/80">
  <ul class="container-x grid grid-cols-2 gap-x-6 gap-y-4 py-6 text-sm sm:grid-cols-3 lg:flex lg:items-center lg:justify-between">
    {shown.map((it, i) => (
      <li class:list={["flex items-center gap-2.5 font-semibold text-ink/90", i === shown.length - 1 && "col-span-2 sm:col-span-1"]}>
        <Icon name={it.icon} class="size-5 shrink-0 text-glow" />
        <span>{it.text}</span>
      </li>
    ))}
  </ul>
</section>
