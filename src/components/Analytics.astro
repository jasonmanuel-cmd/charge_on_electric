---
// Google Tag Manager + Microsoft Clarity, gated behind Google Consent Mode v2.
// Nothing loads unless the IDs are configured. Analytics stay denied until the visitor accepts.
import { PUBLIC_GTM_ID, PUBLIC_CLARITY_PROJECT_ID } from "astro:env/client";
const gtm = PUBLIC_GTM_ID;
const clarity = PUBLIC_CLARITY_PROJECT_ID;
const enabled = Boolean(gtm || clarity);
---
{enabled && (
  <script is:inline define:vars={{ gtm, clarity }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;
    var stored = null;
    try { stored = localStorage.getItem("coe-consent"); } catch (e) {}
    var granted = stored === "granted";
    // California visitors: default to denied until an explicit choice is made.
    gtag("consent", "default", {
      ad_storage: granted ? "granted" : "denied",
      ad_user_data: granted ? "granted" : "denied",
      ad_personalization: granted ? "granted" : "denied",
      analytics_storage: granted ? "granted" : "denied",
      wait_for_update: 500,
    });
    window.__coeLoadTrackers = function () {
      if (window.__coeTrackersLoaded) return;
      window.__coeTrackersLoaded = true;
      if (gtm) {
        dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtm.js?id=" + gtm;
        document.head.appendChild(s);
      }
      if (clarity) {
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarity);
      }
    };
    // GTM runs in consent mode (cookieless pings while denied); Clarity only after consent.
    if (gtm && !clarity) window.__coeLoadTrackers();
    else if (granted) window.__coeLoadTrackers();
  </script>
)}

{enabled && (
  <div id="consent-banner" class="fixed inset-x-3 bottom-24 z-[55] hidden md:inset-x-auto md:bottom-6 md:right-6 md:max-w-md" role="region" aria-label="Cookie preferences">
    <div class="card border-glow/30 bg-deep/95 p-5 shadow-2xl shadow-black/60">
      <p class="text-sm leading-relaxed text-muted">
        We use analytics cookies to understand how visitors use this site and improve it. You can accept or decline. See our <a href="/privacy-policy" class="text-glow underline underline-offset-4">Privacy Policy</a>.
      </p>
      <div class="mt-4 flex gap-2">
        <button type="button" class="btn btn-ghost flex-1 !min-h-11" data-consent="denied">Decline</button>
        <button type="button" class="btn btn-primary flex-1 !min-h-11" data-consent="granted">Accept</button>
      </div>
    </div>
  </div>
)}

{enabled && (
  <script>
    const banner = document.getElementById("consent-banner");
    if (banner) {
      let stored: string | null = null;
      try { stored = localStorage.getItem("coe-consent"); } catch {}
      if (!stored) banner.classList.remove("hidden");
      const apply = (value: "granted" | "denied") => {
        try { localStorage.setItem("coe-consent", value); } catch {}
        const w = window as any;
        w.gtag?.("consent", "update", {
          ad_storage: value, ad_user_data: value, ad_personalization: value, analytics_storage: value,
        });
        if (value === "granted") w.__coeLoadTrackers?.();
        banner.classList.add("hidden");
      };
      banner.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((b) =>
        b.addEventListener("click", () => apply(b.dataset.consent as "granted" | "denied")),
      );
      document.querySelectorAll("[data-consent-open]").forEach((b) =>
        b.addEventListener("click", () => banner.classList.remove("hidden")),
      );
    }
  </script>
)}
