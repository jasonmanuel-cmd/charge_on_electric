---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  as?: "h1" | "h2";
}
const { eyebrow, title, intro, align = "left", as: Tag = "h2" } = Astro.props;
---
<div class:list={["max-w-3xl", align === "center" && "mx-auto text-center"]} data-reveal>
  {eyebrow && <p class="eyebrow"><span class="h-px w-6 bg-glow/70"></span>{eyebrow}</p>}
  <Tag class="mt-4 text-3xl font-extrabold leading-[1.08] text-white sm:text-4xl lg:text-[2.9rem]">
    <slot name="title">{title}</slot>
  </Tag>
  {intro && <p class="mt-5 text-lg leading-relaxed text-muted">{intro}</p>}
  <slot />
</div>
