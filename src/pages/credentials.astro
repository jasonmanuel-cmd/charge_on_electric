---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import FinalCta from "../components/FinalCta.astro";
import { business, licenseVisible } from "../config/business";

const cslbLookup = "https://www.cslb.ca.gov/OnlineServices/CheckLicenseII/CheckLicense.aspx";
const items = [
  licenseVisible() && {
    icon: "shield",
    title: `California CSLB License #${business.license.number}`,
    body: `Classification: ${business.license.classification}. You can verify any California contractor's license status directly with the Contractors State License Board.`,
    link: { label: "Verify on CSLB.ca.gov", href: cslbLookup },
  },
  business.insured && { icon: "file", title: "Insured", body: "Certificate of insurance available on request." },
  business.warranty && { icon: "clipboard", title: "Workmanship warranty", body: business.warranty },
].filter(Boolean) as { icon: any; title: string; body: string; link?: { label: string; href: string } }[];
---
<BaseLayout
  title="Credentials & Licensing | Charge On Electric"
  description="Licensing and credential information for Charge On Electric Inc., with a link to verify contractor status with the California CSLB."
  breadcrumbs={[{ name: "Credentials", href: "/credentials" }]}
  view="view_credentials"
>
  <PageHero
    compact
    eyebrow="Credentials"
    title="Verify before you hire. Always."
    subtitle="We encourage every customer to check any contractor's license. Here's where to find ours."
    breadcrumbs={[{ name: "Credentials", href: "/credentials" }]}
  />
  <section class="section">
    <div class="container-x max-w-4xl space-y-5">
      {items.length > 0 ? items.map((it) => (
        <div class="card flex flex-col gap-5 p-7 sm:flex-row sm:items-center" data-reveal>
          <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-electric/15 text-glow"><Icon name={it.icon} class="size-7" /></span>
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white">{it.title}</h2>
            <p class="mt-1.5 leading-relaxed text-muted">{it.body}</p>
          </div>
          {it.link && <a href={it.link.href} target="_blank" rel="noopener" class="btn btn-ghost shrink-0">{it.link.label}</a>}
        </div>
      )) : (
        <div class="card p-8" data-reveal>
          <h2 class="text-xl font-bold text-white">Credential details are being finalized</h2>
          <p class="mt-2 leading-relaxed text-muted">We only publish credentials once they're verified. In the meantime, you can look up any California contractor on the CSLB website, or ask us for our license information when we reach out.</p>
          <a href={cslbLookup} target="_blank" rel="noopener" class="btn btn-ghost mt-6">CSLB License Lookup</a>
        </div>
      )}
    </div>
  </section>
  <FinalCta />
</BaseLayout>
