---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FinalCta from "../components/FinalCta.astro";
import { publishedServices } from "../data/services";
---
<BaseLayout
  title="Electrical Services in Los Angeles | EV Chargers, Panels & More | Charge On Electric"
  description="EV charger installation, electrical panel upgrades, commercial EV charging, and residential and commercial electrical services from Charge On Electric in Los Angeles."
  breadcrumbs={[{ name: "Services", href: "/services" }]}
>
  <PageHero
    compact
    eyebrow="Services"
    title="Built To Power The Future."
    subtitle="Modern electrical solutions for the way you live, drive, build, and grow, for homes and businesses in Los Angeles."
    breadcrumbs={[{ name: "Services", href: "/services" }]}
    primary={{ label: "Get an Estimate", href: "/request-estimate" }}
    secondary={{ label: "Check My EV Readiness", href: "/ev-readiness-check" }}
  />
  <section class="section">
    <div class="container-x grid gap-6 md:grid-cols-2">
      {publishedServices.map((s, i) => <ServiceCard service={s} index={i} />)}
    </div>
  </section>
  <div class="border-t border-line bg-deep/40"><HowItWorks /></div>
  <FinalCta />
</BaseLayout>
