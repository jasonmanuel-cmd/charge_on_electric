---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import FinalCta from "../components/FinalCta.astro";
import { faqs, FAQ_REVIEWED_AT } from "../data/faqs";
import { faqSchema } from "../lib/schema";
import { business } from "../config/business";

const reviewed = new Date(FAQ_REVIEWED_AT + "T12:00:00").toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout
  title="EV Charger & Electrical FAQ | Charge On Electric, Bakersfield"
  description="Answers about home EV charger installation, panel capacity, permits, cost factors, outdoor chargers, and commercial EV charging from Charge On Electric."
  breadcrumbs={[{ name: "FAQ", href: "/faq" }]}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    compact
    eyebrow="FAQ"
    title="Straight answers before you commit."
    subtitle="The questions we hear most about EV charging, electrical panels, and planning a project."
    breadcrumbs={[{ name: "FAQ", href: "/faq" }]}
  />
  <section class="section">
    <div class="container-x max-w-4xl">
      <FaqAccordion items={faqs} />
      <p class="mt-6 text-sm text-muted">Last reviewed {reviewed} by {business.legalName}. Answers are general. Your project's specifics, including permit requirements, are confirmed during the estimate.</p>
      <div class="card mt-10 flex flex-col items-start gap-5 p-7 sm:flex-row sm:items-center sm:justify-between">
        <div><h2 class="text-xl font-bold text-white">Still have a question?</h2><p class="mt-1 text-muted">Ask us directly. We'll give you a straight answer.</p></div>
        <a href="/contact" class="btn btn-primary shrink-0">Ask Us</a>
      </div>
    </div>
  </section>
  <FinalCta />
</BaseLayout>
