---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ProofSection from "../components/ProofSection.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import FinalCta from "../components/FinalCta.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PowerFlow from "../components/PowerFlow.astro";
import { publishedServices, getService, type ServicePage } from "../data/services";
import { faqSchema, serviceSchema } from "../lib/schema";

export function getStaticPaths() {
  return publishedServices.map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: ServicePage };
const site = Astro.site ?? new URL(Astro.url.origin);
const related = s.relatedServiceSlugs.map(getService).filter((x): x is ServicePage => !!x && x.status === "published");
const crumbs = [{ name: "Services", href: "/services" }, { name: s.navLabel, href: `/${s.slug}` }];
const isCommercial = s.slug === "commercial-ev-charging";
---
<BaseLayout
  title={s.seoTitle}
  description={s.metaDescription}
  breadcrumbs={crumbs}
  view="view_service"
  schema={[
    serviceSchema(site, { name: s.navLabel, description: s.metaDescription, slug: s.slug, serviceType: s.navLabel }),
    ...(s.faqs.length ? [faqSchema(s.faqs)] : []),
  ]}
>
  <PageHero eyebrow={s.eyebrow} title={s.heroHeadline} subtitle={s.heroSubheadline} breadcrumbs={crumbs} primary={s.primaryCta} secondary={s.secondaryCta} />

  <!-- Direct answer + who it's for -->
  <section class="section">
    <div class="container-x grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <div>
        <SectionHeading title={s.directAnswer.heading} />
        <div class="mt-6 space-y-5 text-lg leading-relaxed text-muted" data-reveal>
          {s.directAnswer.body.map((p) => <p>{p}</p>)}
        </div>
        {s.slug === "ev-charger-installation" && <div class="card mt-10 p-6 sm:p-8" data-reveal><PowerFlow /></div>}
      </div>
      <aside class="card h-fit p-7 sm:p-8" data-reveal>
        <h2 class="flex items-center gap-2 text-lg font-bold text-white"><Icon name="users" class="size-5 text-glow" /> {isCommercial ? "Ideal for" : "Who this is for"}</h2>
        <ul class="mt-5 space-y-3">
          {s.targetAudience.map((t) => <li class="flex gap-3 text-ink/90"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-glow" />{t}</li>)}
        </ul>
        <a href={s.primaryCta.href} class="btn btn-primary mt-8 w-full">{s.primaryCta.label}</a>
      </aside>
    </div>
  </section>

  <!-- Included + scope factors -->
  <section class="section border-y border-line bg-deep/60">
    <div class="container-x grid gap-6 lg:grid-cols-2">
      <div class="card p-8 sm:p-10" data-reveal>
        <span class="grid size-11 place-items-center rounded-xl bg-electric/15 text-glow"><Icon name={s.icon} class="size-5" /></span>
        <h2 class="mt-6 text-2xl font-bold text-white">{s.includedHeading}</h2>
        <ul class="mt-6 space-y-3.5">
          {s.includedItems.map((t) => <li class="flex gap-3 text-ink/90"><Icon name="check" class="mt-0.5 size-5 shrink-0 text-glow" />{t}</li>)}
        </ul>
      </div>
      <div class="card p-8 sm:p-10" data-reveal style="--reveal-delay:100ms">
        <span class="grid size-11 place-items-center rounded-xl bg-cyan/15 text-glow"><Icon name="gauge" class="size-5" /></span>
        <h2 class="mt-6 text-2xl font-bold text-white">What affects scope and price</h2>
        <p class="mt-3 text-muted">Every property is different. These are the factors we look at before quoting:</p>
        <ul class="mt-6 space-y-3.5">
          {s.scopeFactors.map((t) => <li class="flex gap-3 text-ink/90"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-glow shadow-[0_0_8px_#7fe3ff]"></span>{t}</li>)}
        </ul>
      </div>
    </div>
    <div class="container-x mt-6 grid gap-6 lg:grid-cols-2">
      <div class="flex gap-4 rounded-2xl border border-line bg-white/[0.02] p-6" data-reveal>
        <Icon name="file" class="size-6 shrink-0 text-glow" />
        <div><h3 class="font-bold text-white">Permits &amp; inspections</h3><p class="mt-1.5 text-sm leading-relaxed text-muted">{s.permitNote}</p></div>
      </div>
      {s.photoTip && (
        <div class="flex gap-4 rounded-2xl border border-line bg-white/[0.02] p-6" data-reveal>
          <Icon name="camera" class="size-6 shrink-0 text-glow" />
          <div><h3 class="font-bold text-white">Get a faster estimate</h3><p class="mt-1.5 text-sm leading-relaxed text-muted">{s.photoTip}</p></div>
        </div>
      )}
    </div>
  </section>

  <HowItWorks eyebrow="Our Process" title={`How ${s.navLabel.toLowerCase()} works`} steps={s.processSteps} cta={s.primaryCta} />

  <ProofSection limit={3} />

  {s.faqs.length > 0 && (
    <section class="section">
      <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <SectionHeading eyebrow="FAQ" title={`${s.navLabel} questions`} />
        <div data-reveal><FaqAccordion items={s.faqs} /></div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section pt-0">
      <div class="container-x">
        <SectionHeading eyebrow="Related Services" title="Often paired with this work" />
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {related.map((r, i) => <ServiceCard service={r} index={i} />)}
        </div>
      </div>
    </section>
  )}

  <FinalCta primary={s.primaryCta} />
</BaseLayout>
