# Copy to .env for local development. On Vercel, set these in Project Settings > Environment Variables.
# Everything is optional: without Supabase/Resend the lead form still works and saves leads to .data/leads (dev only).

PUBLIC_SITE_URL=https://www.chargeonelectric.com

# Analytics (public)
PUBLIC_GTM_ID=
PUBLIC_CLARITY_PROJECT_ID=

# Spam protection (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead storage (server-only). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=lead-uploads

# Lead notifications (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=
